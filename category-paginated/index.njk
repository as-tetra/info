---
pagination:
  data: categoryPages
  size: 1
  alias: page
permalink: "{{ page.permalink }}"
layout: base.njk
bodyClass: "event_archive_responsive"
title: "{{ page.categoryName }}"
---

{# カテゴリーアーカイブ - MTのMTPaginate相当 #}
<div class="main">
  {# ヘッダー #}
  <div class="block_box">
    <h1 class="menu_title">{{ page.categoryName }}</h1>
  </div>

  {# エントリーリスト (MTPaginateContent) #}
  <div class="archive-list">
    {% for entry in page.entries %}
    {% include "components/entry-card-simple.njk" %}
    {% endfor %}
  </div>

  {# ページネーション (MTPaginateIfMultiplePages) #}
  {% set customPagination = page %}
  {% set baseUrl = '/' + page.categorySlug %}
  {% include "components/pagination.njk" %}

  {# メインナビゲーション #}
  {% include "components/main-navigation.njk" %}
</div>
